<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptic warning in the final 2s of drawing. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Daily "come back and play" reminder (notifications/DailyEngagementWorker.kt)
         and friend match-invite push notifications (notifications/FriendInviteMessagingService.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The daily reminder is an AlarmManager alarm (see NotificationScheduler),
         and alarms do not survive a reboot — without this the reminder would
         work until the phone is next restarted and then stop silently. No
         SCHEDULE_EXACT_ALARM: the alarm is deliberately inexact (Play only
         grants exact alarms to alarm-clock and calendar apps). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- play-services-ads (see build.gradle.kts) needs these to actually
         read/use an advertising ID — AD_ID plus its newer Android
         AdServices/Privacy Sandbox counterparts. Previously stripped with
         tools:node="remove" while GameConstants.ADMOB_ENABLED was false;
         now that ads are genuinely on, removing them would make Play
         Console's "does your app use advertising ID" declaration and the
         Data Safety form (see PLAY_STORE.md) false. Strip them again
         (tools:node="remove" on each) if ADMOB_ENABLED ever goes back to
         false. -->

    <application
        android:name=".CizimHafizaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locale_config"
        android:theme="@style/Theme.CizimHafiza">

        <!-- Portrait only. The whole game is a drawing canvas and a timed
             guess field sized for one hand on a tall screen; rotating mid-round
             would also recreate the Activity and take the countdown and the
             half-finished drawing with it. -->
        <!-- configChanges="locale|layoutDirection": without this, ANY locale
             change the OS notices — the Settings screen's language toggle
             included — leaves this Activity undeclared for that config
             category, so Android destroys and recreates it by default
             REGARDLESS of any window-background or transition-suppression
             code the Activity itself runs: those only ever influenced what
             a recreate looked like, never whether one happened, which is
             the actual source of the black flash a recreate can show on
             some OEM skins (MIUI). Declaring it here is what makes Android
             skip the destroy+recreate entirely and call
             MainActivity.onConfigurationChanged() instead — see that
             override for why nothing else has to change for Compose to
             pick the new language up live. -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Karalak.Splash"
            android:configChanges="locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Room invite links shared from the Waiting Room, e.g.
                 karalak://join/482913 — opens straight into "Koda Katıl"
                 with the code pre-filled if Karalak is already installed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="karalak" android:host="join" />
            </intent-filter>

            <!-- Friend/referral invite links shared from the Friends screen,
                 e.g. karalak://friend/482913 — opens straight into Friends
                 with the sender's code pre-filled if Karalak is already
                 installed (see FriendsViewModel / recordReferralIfEligible). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="karalak" android:host="friend" />
            </intent-filter>
        </activity>

        <!-- Required by the Play Services Ads manifest merger in every build
             variant regardless of GameConstants.ADMOB_ENABLED — the merge
             fails without it even when no ad is ever requested. Real value
             comes from local.properties' ADMOB_APP_ID (see build.gradle.kts);
             falls back to Google's public test app ID if that key is
             missing. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Delivers push notifications for friend match invites sent while
             this device isn't in the app (see functions/src/index.ts for
             the Cloud Function that sends them). -->
        <service
            android:name=".notifications.FriendInviteMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Fires the daily reminder alarm, and re-arms it after a reboot or
             an app update (both wipe pending alarms). exported="false" is
             correct even for BOOT_COMPLETED: the system delivers protected
             broadcasts to non-exported receivers, which is exactly how
             WorkManager's own RescheduleReceiver is declared. -->
        <receiver
            android:name=".notifications.DailyReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Lets AppCompat auto-persist the chosen per-app language across
             process restarts on Android 8-12 (API 26-32), where the
             framework's own LocaleManager isn't available yet. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Exposes cached shared-drawing PNGs to the share sheet as content:// URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager auto-initializes itself via this provider by default,
             which would build its own Configuration and ignore the
             HiltWorkerFactory CizimHafizaApp supplies. Removing it here lets
             WorkManager.getInstance() lazily initialize using the
             Configuration.Provider implementation on CizimHafizaApp instead
             (standard Hilt + WorkManager wiring). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- play-services-ads and firebase-analytics (pulled in alongside
             Crashlytics) each declare this Privacy Sandbox config property
             pointing at their own XML, and the manifest merger refuses to
             pick one. The ads SDK's config is the one that matters here:
             this app serves ads (see the AD_ID / AdServices permissions kept
             near the top of this file) but has Analytics collection
             disabled — Crashlytics only needs the Analytics artifact on the
             classpath, it does not need Analytics itself to be measuring
             anything. -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
    </application>

</manifest>
