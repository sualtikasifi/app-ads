rules_version = '2';

// Security rules for Karalak's online friend-vs-friend rooms.
// Apply in the Firebase console: Firestore Database → Rules → paste this →
// Publish. See the "rooms/{roomCode}" comment on OnlineGameRepositoryImpl.kt
// for the matching data shape.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomCode} {
      // Anyone signed in (anonymous auth counts) can read a room — needed to
      // look up a room by code before you're a listed player yet.
      allow read: if request.auth != null;

      // Creating a room: you must be its host, and the initial players map
      // must contain only you — except the permanent bot room (130246, see
      // BotRoomEngine.kt), which has no real owner and gets bootstrapped by
      // whichever real player's app finds it missing.
      allow create: if request.auth != null
                    && (
                      (request.resource.data.hostUid == request.auth.uid
                       && request.resource.data.players.keys().hasOnly([request.auth.uid]))
                      || roomCode == '130246'
                    );

      // Updating a room: allowed once you're already a listed player
      // (covers ready-up, starting the match, submitting your result,
      // rematch votes, leaving, kicking/unbanning another player) — or
      // you're joining a still-open room under the room-size cap (keep in
      // sync with GameConstants.MAX_ROOM_SIZE in the app), joinable while
      // WAITING *or* PLAYING (a mid-round joiner sits out that round as
      // pendingNextRound — see OnlinePlayer.kt), as long as the host
      // hasn't kicked this device with a still-active ban (kickedUsers,
      // see OnlineGameRepositoryImpl.kickPlayer — this is the real
      // enforcement, the app's own pre-join check is just for a nicer
      // error message). Room 130246 (see BotRoomEngine.kt) is wide open:
      // any signed-in device may need to drive the bot's moves or repair a
      // stuck match, not just its currently-listed players — same trust
      // level as botTrainedWords below, no real user data at stake in this
      // one shared practice room.
      allow update: if request.auth != null
                    && (
                      roomCode == '130246'
                      || resource.data.players.keys().hasAny([request.auth.uid])
                      || (
                        resource.data.players.size() < 8
                        && (resource.data.status == 'WAITING' || resource.data.status == 'PLAYING')
                        && (
                          !(request.auth.uid in resource.data.get('kickedUsers', {}))
                          || request.time.toMillis() > resource.data.kickedUsers[request.auth.uid].until
                        )
                      )
                    );

      allow delete: if false;

      match /results/{uid} {
        // Every player needs to read every other player's drawings; you can
        // only ever write your own result doc — except the bot's result doc
        // in room 130246 (uid == 'karalak-bot', see BotRoomEngine.kt), which
        // isn't a real Firebase Auth identity, so it's written on the bot's
        // behalf by whichever real device is driving that room.
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && (request.auth.uid == uid || (roomCode == '130246' && uid == 'karalak-bot'));
      }

      match /reactions/{reactionId} {
        // Append-only chat log: anyone in the room can read, you can only
        // post a reaction stamped with your own uid, nothing is editable —
        // except room 130246's bot reactions (uid == 'karalak-bot', not a
        // real Auth identity, see BotRoomEngine.kt), also driven by
        // whichever real device is around.
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && (
                        request.resource.data.uid == request.auth.uid
                        || (roomCode == '130246' && request.resource.data.uid == 'karalak-bot')
                      );
        allow update, delete: if false;
      }
    }

    // Permanent friend codes — see the "users/{uid}" comment on
    // FriendRepositoryImpl.kt for the matching data shape. Mirrors
    // rooms/{roomCode}: a code->uid lookup doc, except this one never rotates.
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      // Your own profile (nickname + friendCode) — anyone can read it (needed
      // to resolve a friend's nickname when they add you), only you write it.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /friends/{friendUid} {
        // Only you read your own friends list. Adding a friend is mutual and
        // written from one client in a single batch (see addFriendByCode),
        // so either side of the friendship — you writing your own list, or
        // you writing yourself into your new friend's list — is allowed.
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      match /invites/{inviteId} {
        // Only the recipient reads/dismisses their own invites. Anyone
        // signed in can create one for someone else (that's the point of an
        // invite) as long as it's stamped with their own uid as the sender —
        // unless the recipient has blocked them, or declined them within the
        // last 5 minutes (keep the 300000ms window in sync with
        // GameConstants.FRIEND_INVITE_COOLDOWN_MILLIS in the app). This is
        // the real enforcement of both — the app's own pre-send check is
        // just for a nicer error message, not security.
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && request.resource.data.fromUid == request.auth.uid
                      && !exists(/databases/$(database)/documents/users/$(uid)/blockedUsers/$(request.auth.uid))
                      && (
                        !exists(/databases/$(database)/documents/users/$(uid)/inviteCooldowns/$(request.auth.uid))
                        || request.time.toMillis() > get(/databases/$(database)/documents/users/$(uid)/inviteCooldowns/$(request.auth.uid)).data.declinedAt + 300000
                      );
        allow update: if false;
      }

      match /blockedUsers/{blockedUid} {
        // The owner manages their own block list. The blocked person can
        // also read their own entry (but nobody else's) — that's what lets
        // a would-be sender show a friendly "this person blocked you"
        // message instead of a raw permission error before even trying to
        // invite; it does not expose who else uid has blocked.
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == blockedUid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /inviteCooldowns/{fromUid} {
        // Same shape as blockedUsers above: owner manages it, the person on
        // cooldown can read their own entry to show a specific "wait N more
        // minutes" message.
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fromUid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Bot-opponent training data (see presentation/bottraining/ + the "Bot
    // Eğitim" main-menu entry): one doc per word id, holding the hand-drawn
    // stroke data the bot replays as its own "drawing" in room 130246 (see
    // functions/src/index.ts's onBotRoomWrite). No per-user ownership model
    // here — same trust level as rooms/{roomCode}/results/{uid}, just keyed
    // by word id instead of uid.
    match /botTrainedWords/{wordId} {
      allow read, write: if request.auth != null;
    }
  }
}
