rules_version = '2';

// Security rules for Karalak's online friend-vs-friend rooms.
// Apply in the Firebase console: Firestore Database → Rules → paste this →
// Publish. See the "rooms/{roomCode}" comment on OnlineGameRepositoryImpl.kt
// for the matching data shape.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomCode} {
      // Anyone signed in (anonymous auth counts) can read a room — needed to
      // look up a room by code before you're a listed player yet.
      allow read: if request.auth != null;

      // Creating a room: you must be its host, and the initial players map
      // must contain only you.
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.players.keys().hasOnly([request.auth.uid]);

      // Updating a room: allowed once you're already a listed player
      // (covers ready-up, starting the match, submitting your result,
      // rematch votes, leaving) — or you're joining a still-open room
      // under the room-size cap (keep in sync with
      // GameConstants.MAX_ROOM_SIZE in the app).
      allow update: if request.auth != null
                    && (
                      resource.data.players.keys().hasAny([request.auth.uid])
                      || (resource.data.players.size() < 8 && resource.data.status == 'WAITING')
                    );

      allow delete: if false;

      match /results/{uid} {
        // Every player needs to read every other player's drawings; you can
        // only ever write your own result doc.
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /reactions/{reactionId} {
        // Append-only chat log: anyone in the room can read, you can only
        // post a reaction stamped with your own uid, nothing is editable.
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Permanent friend codes — see the "users/{uid}" comment on
    // FriendRepositoryImpl.kt for the matching data shape. Mirrors
    // rooms/{roomCode}: a code->uid lookup doc, except this one never rotates.
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      // Your own profile (nickname + friendCode) — anyone can read it (needed
      // to resolve a friend's nickname when they add you), only you write it.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /friends/{friendUid} {
        // Only you read your own friends list. Adding a friend is mutual and
        // written from one client in a single batch (see addFriendByCode),
        // so either side of the friendship — you writing your own list, or
        // you writing yourself into your new friend's list — is allowed.
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      match /invites/{inviteId} {
        // Only the recipient reads/dismisses their own invites. Anyone
        // signed in can create one for someone else (that's the point of an
        // invite) as long as it's stamped with their own uid as the sender.
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
